# URLs propres : tout passe par le front controller, sauf les fichiers réels.
RewriteEngine On

# Sert directement les fichiers/dossiers existants (assets, images, css…).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Tout le reste est routé vers index.php (front controller).
RewriteRule ^ index.php [L]
