# ===== TEMPLATE — SAFE TO COMMIT ON GITHUB =====
# Copy this file to .env and replace the values:
#   cp .env.example .env
# Then edit .env with your real credentials.

# --- MySQL database ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=db
MYSQL_USER=user
MYSQL_PASSWORD=change_me_user

# --- Ports exposed on your Mac (dev only, unused in prod) ---
PHP_PORT=8080
MYSQL_PORT=3306
PMA_PORT=8081

# --- Domaine de production ---
# Utilisé par Caddy + Let's Encrypt (chemin VPS nu) ET par APP_URL (chemin Coolify).
#
# ⚠️ PIÈGE : si DOMAIN n'est pas défini, APP_URL vaut "https://" et TOUS les liens
#    de réinitialisation de mot de passe seront cassés (#42). Docker Compose ne
#    bloque pas — il émet un simple warning que personne ne lit.
#    Sur Coolify : définir DOMAIN dans les variables d'environnement de l'app,
#    avec la MÊME valeur que le domaine configuré dans l'UI.
DOMAIN=gestio.codingqueen40.com

# --- SMTP relay (Brevo — 300 emails/jour gratuits) ---
# Obtenir les credentials sur https://app.brevo.com → SMTP & API
# ⚠️ Brevo exige la VÉRIFICATION du domaine expéditeur (enregistrements DNS)
#    avant d'accepter d'envoyer depuis une adresse @ton-domaine.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login@example.com
SMTP_PASSWORD=your_brevo_smtp_key
SMTP_FROM=noreply@codingqueen40.com

# =====================================================================
# DÉPLOIEMENT COOLIFY — variables à renseigner dans l'UI (pas dans un .env)
# =====================================================================
# Fichier compose à utiliser : docker-compose.coolify.yml (autonome, pas de merge).
# Variables requises côté Coolify :
#   DOMAIN, MYSQL_ROOT_PASSWORD, MYSQL_DATABASE, MYSQL_USER, MYSQL_PASSWORD,
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_FROM
# Le reverse proxy et le HTTPS sont assurés par Traefik (fourni par Coolify) —
# le service `caddy` est volontairement absent du fichier Coolify.
